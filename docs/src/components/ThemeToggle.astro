---
// The colour theme as one icon button beside the site title. Each click steps Auto (follow the
// system) -> Light -> Dark -> Auto. It stores the choice the way Starlight's own theme select
// does (localStorage `starlight-theme`, empty for Auto), so the select in the phone menu and
// this button always agree.
---

<button type="button" class="theme-toggle" data-theme-toggle data-pref="auto" aria-label="Theme: Auto, following the system. Switch to Light">
	<svg class="auto" viewBox="0 0 24 24" aria-hidden="true">
		<rect x="3" y="4" width="18" height="12" rx="1.5"></rect>
		<path d="M8 20h8M12 16v4"></path>
	</svg>
	<svg class="light" viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
	</svg>
	<svg class="dark" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
	</svg>
</button>

<script is:inline>
	(() => {
		const stored = typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
		const pref = stored === 'light' || stored === 'dark' ? stored : 'auto';
		for (const b of document.querySelectorAll('[data-theme-toggle]')) b.dataset.pref = pref;
	})();
</script>

<script>
	type Pref = 'auto' | 'light' | 'dark';

	const KEY = 'starlight-theme';
	const NEXT: Record<Pref, Pref> = { auto: 'light', light: 'dark', dark: 'auto' };
	const NAME: Record<Pref, string> = { auto: 'Auto, following the system', light: 'Light', dark: 'Dark' };

	const read = (): Pref => {
		try {
			const v = localStorage.getItem(KEY);
			return v === 'light' || v === 'dark' ? v : 'auto';
		} catch {
			return 'auto';
		}
	};
	const system = () => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');

	function render(pref: Pref) {
		for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
			button.dataset.pref = pref;
			button.setAttribute('aria-label', `Theme: ${NAME[pref]}. Switch to ${NAME[NEXT[pref]].split(',')[0]}`);
		}
	}

	function apply(pref: Pref) {
		try {
			localStorage.setItem(KEY, pref === 'auto' ? '' : pref);
		} catch {}
		document.documentElement.dataset.theme = pref === 'auto' ? system() : pref;
		(window as unknown as { StarlightThemeProvider?: { updatePickers(t: Pref): void } }).StarlightThemeProvider?.updatePickers(pref);
		render(pref);
	}

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
		button.addEventListener('click', () => apply(NEXT[read()]));
	}
	// Keep the icon in step when the phone menu's select changes the theme.
	document.addEventListener('change', (event) => {
		if ((event.target as Element).matches?.('starlight-theme-select select')) setTimeout(() => render(read()));
	});
	render(read());
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 1px solid transparent;
		border-radius: 0.375rem;
		background: transparent;
		color: var(--gr-text);
		cursor: pointer;
	}

	.theme-toggle:hover {
		border-color: var(--gr-line);
		color: var(--gr-text-strong);
	}

	svg {
		display: none;
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	[data-pref='auto'] .auto,
	[data-pref='light'] .light,
	[data-pref='dark'] .dark {
		display: block;
	}
</style>
