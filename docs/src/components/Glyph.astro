---
// The site's small icons in one place. Brand marks (GitHub, Discord) are Starlight's own; Ko-fi
// and the Roadmap's stage icons are drawn here. Always decorative: the link or heading beside
// the icon carries the words, so every icon is aria-hidden.
import { Icon } from '@astrojs/starlight/components';

export type GlyphName =
	| 'github'
	| 'discord'
	| 'kofi'
	| 'proposed'
	| 'up-next'
	| 'in-progress'
	| 'released'
	| 'now'
	| 'completed';

interface Props {
	name: GlyphName;
	class?: string;
}

const { name, class: className } = Astro.props;

// The Roadmap's stage icons, one family on a 24-unit grid, so a lane reads as a step along the
// way: a dashed circle for an idea not yet decided, an empty circle for work slated, a
// half-filled circle for work underway, and a filled circle with a tick for work done. The
// markup is fixed here, never from data.
const STAGE = {
	open: '<circle cx="12" cy="12" r="8.5"/>',
	half: '<circle cx="12" cy="12" r="8.5"/><path class="fill" d="M12 6.5a5.5 5.5 0 0 1 0 11Z"/>',
	done: '<circle class="fill" cx="12" cy="12" r="9.5"/><path class="cut" d="m8.2 12.3 2.6 2.6 5-5.2"/>',
};
const STAGES: Partial<Record<GlyphName, string>> = {
	proposed: '<circle class="dashed" cx="12" cy="12" r="8.5"/>',
	'up-next': STAGE.open,
	'in-progress': STAGE.half,
	released: STAGE.done,
	now: STAGE.half,
	completed: STAGE.done,
};

const KOFI =
	'M11.351 2.715c-2.7 0-4.986.025-6.83.26C2.078 3.285 0 5.154 0 8.61c0 3.506.182 6.13 1.585 8.493 1.584 2.701 4.233 4.182 7.662 4.182h.83c4.209 0 6.494-2.234 7.637-4a9.5 9.5 0 0 0 1.091-2.338C21.792 14.688 24 12.22 24 9.208v-.415c0-3.247-2.13-5.507-5.792-5.870-1.558-.156-2.650-.208-6.857-.208m0 1.947c4.208 0 5.090.052 6.571.182 2.624.311 4.130 1.584 4.130 4v.39c0 2.156-1.792 3.844-3.870 3.844h-.935l-.156.649c-.208 1.013-.597 1.818-1.039 2.546-.909 1.428-2.545 3.064-5.922 3.064h-.805c-2.571 0-4.831-.883-6.078-3.195-1.090-2-1.298-4.155-1.298-7.506 0-2.181.857-3.402 3.012-3.714 1.533-.233 3.559-.26 6.390-.26m6.547 2.287c-.416 0-.650.234-.650.546v2.935c0 .311.234.545.650.545 1.324 0 2.051-.754 2.051-2s-.727-2.026-2.052-2.026m-10.390.182c-1.818 0-3.013 1.480-3.013 3.142 0 1.533.858 2.857 1.949 3.897.727.701 1.870 1.429 2.649 1.896a1.470 1.470 0 0 0 1.507 0c.780-.467 1.922-1.195 2.623-1.896 1.117-1.039 1.974-2.364 1.974-3.897 0-1.662-1.247-3.142-3.039-3.142-1.065 0-1.792.545-2.338 1.298-.493-.753-1.246-1.298-2.312-1.298';
---

{
	name === 'github' || name === 'discord' ? (
		<Icon name={name} size="1.25rem" class:list={['glyph', className]} />
	) : name === 'kofi' ? (
		<svg class:list={['glyph', 'filled', className]} viewBox="0 0 24 24" aria-hidden="true">
			<path d={KOFI} />
		</svg>
	) : (
		<svg class:list={['glyph', 'stage', className]} viewBox="0 0 24 24" aria-hidden="true" set:html={STAGES[name]} />
	)
}

<style>
	.glyph {
		flex: none;
		width: 1.25rem;
		height: 1.25rem;
	}

	.filled {
		fill: currentColor;
	}

	.stage {
		fill: none;
		stroke: currentColor;
		stroke-width: 2.25;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.stage :global(.fill) {
		fill: currentColor;
		stroke: none;
	}

	.stage :global(.dashed) {
		stroke-dasharray: 3.4 2.9;
	}

	/* The tick is cut out of the filled circle in the page colour. */
	.stage :global(.cut) {
		stroke: var(--gr-base);
		stroke-width: 2.5;
	}
</style>
