---
// Every changelog, newest first, so a visitor can switch versions without the sidebar
// (release showcases are full-width pages). The order comes from the sidebar config.
import { changelogLinks } from '../../data/changelogs';

const links = changelogLinks(Astro.locals.starlightRoute.sidebar as never);
---

{
	links.length > 1 && (
		<nav class="picker" aria-label="Versions">
			<p class="label" id="versions-label">
				All versions
			</p>
			<ul aria-labelledby="versions-label">
				{links.map(({ label, href, isCurrent }) => (
					<li>
						<a href={href} aria-current={isCurrent ? 'page' : undefined}>
							{label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}

<style>
	.picker {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
	}

	.label {
		margin: 0;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--gr-muted);
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 0.9rem;
		border: 1px solid var(--gr-line);
		border-radius: 0.375rem;
		color: var(--gr-text);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
	}

	a:hover {
		border-color: var(--gr-text);
		color: var(--gr-text-strong);
	}

	a[aria-current='page'] {
		border-color: var(--gr-accent);
		color: var(--gr-text-strong);
		box-shadow: inset 0 -3px 0 var(--gr-accent);
	}
</style>
