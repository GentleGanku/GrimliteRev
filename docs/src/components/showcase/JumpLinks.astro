---
// The start of the full changelog on a showcase page: its title and tabs that jump to its
// sections (Additions, Patches, Others, or the build's dates). Below 72rem, where there's no
// "On this page" column, the bar stays under the header while the changelog scrolls past.
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
const sections = headings.some((h) => h.depth === 3)
	? headings.filter((h) => h.depth === 3)
	: headings.filter((h) => h.depth === 2);
const label = (text: string) => {
	const clean = text.replace(/:$/, '');
	return clean === clean.toUpperCase() ? clean.charAt(0) + clean.slice(1).toLowerCase() : clean;
};
---

<nav class="jump not-content" aria-labelledby="full-changelog">
	<h2 id="full-changelog">Full changelog</h2>
	{
		sections.length > 1 && (
			<ul>
				{sections.map((h) => (
					<li>
						<a href={`#${h.slug}`} data-toc-link={h.slug}>
							{label(h.text)}
						</a>
					</li>
				))}
			</ul>
		)
	}
</nav>

<style>
	.jump {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
		margin: 3.5rem 0 1.5rem;
		padding-block: 0.75rem;
		border-bottom: 3px solid var(--gr-text-strong);
		background: var(--gr-base);
	}

	@media (width < 72rem) {
		.jump {
			position: sticky;
			top: var(--sl-nav-height);
			z-index: 3;
		}
	}

	h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1;
		color: var(--gr-text-strong);
		scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
	}

	ul {
		display: flex;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		overflow-x: auto;
		list-style: none;
		scrollbar-width: none;
	}

	a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 1rem;
		border: 1px solid var(--gr-line);
		border-radius: 0.375rem;
		background: var(--gr-surface);
		color: var(--gr-text-strong);
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
	}

	/* Hover, and the section being read (marked by MarkdownContent.astro's script). */
	a:hover,
	a[aria-current='true'] {
		border-color: var(--gr-accent);
		box-shadow: inset 0 -3px 0 var(--gr-accent);
	}
</style>
