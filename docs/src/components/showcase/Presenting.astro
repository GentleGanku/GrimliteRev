---
// A showcase headline: a short lead-in line over a large headline with one highlighted word.
interface Props {
	kicker: string;
	before: string;
	mark: string;
	after: string;
	id?: string;
}

const { kicker, before, mark, after, id } = Astro.props;
---

<div class="presenting">
	<p class="kicker">{kicker}</p>
	<h2 id={id}>
		{before} <mark class="gr-mark">{mark}</mark> {after}
	</h2>
</div>

<style>
	.kicker {
		margin: 0;
		font-size: var(--sl-text-lg);
		font-weight: 600;
		color: var(--gr-muted);
	}

	h2 {
		max-width: 18ch;
		margin: 0.25rem 0 0;
		font-size: clamp(2.25rem, 6vw, 4.25rem);
		line-height: 1;
		color: var(--gr-text-strong);
		text-wrap: balance;
	}
</style>
