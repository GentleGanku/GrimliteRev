---
// The poster at the top of a changelog page: the release name set large over the release's art,
// with a stamp for its date (and "Latest release since" on the newest), and the downloads and
// the version list on its right, centred in the banner's height. The downloads sit on the
// stamp's line. The title is split
// so the version, the part people scan for, is the biggest thing on it.
//
// The hero fills the first screen. It is an art area, so it keeps the dark palette in both
// themes. The art is dimmed to 45% over Base, so the text and the downloads sit straight on it.
import DownloadButtons from '../DownloadButtons.astro';
import HeroMedia from './HeroMedia.astro';
import ReleasePicker from './ReleasePicker.astro';

interface Props {
	title: string;
	stamp?: string;
	release?: string;
	media: { video?: string; image?: string; poster?: string; placeholder?: string; plain?: boolean };
}

const { title, stamp, release, media } = Astro.props;
const match = title.match(/^(.*?)\s+(v\d.*)$/);
const name = match?.[1] ?? '';
const version = match?.[2] ?? title;
// Build names ("v1.3 Skymeister Build") are set smaller than a bare version so they stay on two
// lines, at the size the older builds' posters had before the downloads column was added.
const long = version.length > 8;
---

<header class:list={['poster gr-bleed gr-dark', { plain: media.plain }]}>
	{
		!media.plain && (
			<div class="art">
				<HeroMedia {...media} />
			</div>
		)
	}
	<div class="inner">
		<h1 id="_top">
			{name && <span class="name">{name}</span>}
			<span class:list={['version', { long }]}>{version}</span>
		</h1>
		{stamp && <p class="gr-stamp stamp">{stamp}</p>}
		{
			release && (
				<div class="downloads">
					<DownloadButtons tag={release} layout="stack" />
				</div>
			)
		}
		<div class="versions">
			<ReleasePicker />
		</div>
	</div>
</header>

<style>
	.poster {
		position: relative;
		display: flex;
		align-items: center;
		min-height: calc(100svh - var(--sl-nav-height));
		margin-top: -1.5rem;
		padding-block: 4rem;
		color: var(--gr-text);
	}

	/* The art fills the first screen and ends on a straight edge; the next section starts right
	   there. */
	.art {
		position: absolute;
		inset: 0;
		background: var(--gr-base);
	}

	/* Only the picture is dimmed: the banner's focus ring and the placeholder's label stay at full
	   strength. */
	.art :global(video),
	.art :global(img) {
		opacity: 0.45;
	}

	/* A release with no art: with nothing to look at, half a screen is enough, so the changes
	   start sooner. */
	.poster.plain {
		min-height: 50svh;
		background: var(--gr-surface);
	}

	.inner {
		position: relative;
		z-index: 2;
		display: grid;
		gap: 1.5rem;
		width: 100%;
		pointer-events: none;
	}

	.inner > * {
		pointer-events: auto;
	}

	h1 {
		display: flex;
		flex-direction: column;
		margin: 0;
		line-height: 0.88;
		color: #fff;
		scroll-margin-top: 100vh;
	}

	.name {
		font-size: clamp(1.5rem, 3.5vw, 2.25rem);
		line-height: 1;
		margin-bottom: 0.35rem;
	}

	.version {
		font-size: clamp(3.5rem, 13vw, 9.5rem);
		letter-spacing: -0.02em;
		overflow-wrap: anywhere;
	}

	.version.long {
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		line-height: 0.95;
	}

	.stamp {
		position: relative;
		justify-self: start;
		margin: 0;
		transform: rotate(-3deg);
		transform-origin: left center;
	}

	/* Wide screens: the title on top, then the stamp and the downloads on one line, then the
	   version link under the downloads. */
	@media (min-width: 60rem) {
		.inner {
			grid-template-columns: minmax(0, 1fr) auto;
			grid-template-areas:
				'title .'
				'stamp downloads'
				'. versions';
			align-items: center;
			row-gap: 0.25rem;
		}

		h1 {
			grid-area: title;
			margin-bottom: 1rem;
		}

		.stamp {
			grid-area: stamp;
		}

		.downloads {
			grid-area: downloads;
		}

		.versions {
			grid-area: versions;
		}
	}
</style>
