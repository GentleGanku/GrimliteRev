---
// The poster at the top of a changelog page: the release name set large over the release's art,
// with a stamp label, and the downloads and the version list on its right. The title is split
// so the version, the part people scan for, is the biggest thing on it.
//
// The hero is an art area, so it keeps the dark palette in both themes. The art shows at full
// strength; the text and the downloads each sit on a dark patch (78% Base), which keeps white
// text above 8:1 whatever the art is. The bottom edge fades into the page instead of ending in
// a hard line.
import DownloadButtons from '../DownloadButtons.astro';
import HeroMedia from './HeroMedia.astro';
import ReleasePicker from './ReleasePicker.astro';

interface Props {
	title: string;
	kicker?: string;
	stamp?: string;
	release?: string;
	media: { video?: string; image?: string; poster?: string; placeholder?: string };
}

const { title, kicker, stamp, release, media } = Astro.props;
const match = title.match(/^(.*?)\s+(v\d.*)$/);
const name = match?.[1] ?? '';
const version = match?.[2] ?? title;
// Build names ("v1.3 Skymeister Build") are set smaller than a bare version so they stay on two
// lines.
const long = version.length > 8;
---

<header class="poster gr-bleed gr-dark">
	<div class="art">
		<HeroMedia {...media} />
	</div>
	<div class="inner">
		<div class="copy">
			{kicker && <p class="kicker">{kicker}</p>}
			<h1 id="_top">
				{name && <span class="name">{name}</span>}
				<span class:list={['version', { long }]}>{version}</span>
			</h1>
			{stamp && <p class="gr-stamp stamp">{stamp}</p>}
		</div>
		<div class="side">
			{release && <DownloadButtons tag={release} layout="stack" />}
			<ReleasePicker />
		</div>
	</div>
</header>

<style>
	.poster {
		position: relative;
		display: flex;
		align-items: flex-end;
		min-height: clamp(28rem, 72vh, 44rem);
		margin-top: -1.5rem;
		padding-block: 6rem 7rem;
		color: var(--gr-text);
	}

	/* The art fills the hero and fades out over its last 7rem, into the page below. */
	.art {
		position: absolute;
		inset: 0;
		background: var(--gr-base);
		mask: linear-gradient(to bottom, #000 calc(100% - 7rem), transparent);
	}

	.inner {
		position: relative;
		z-index: 2;
		display: grid;
		gap: 1.5rem;
		width: 100%;
		pointer-events: none;
	}

	.copy,
	.side {
		pointer-events: auto;
	}

	.copy {
		justify-self: start;
		max-width: 100%;
		padding: 1.5rem 1.75rem 2.25rem;
		background: rgb(28 32 40 / 0.78);
		mask: var(--gr-book-edge-bottom) bottom / 100% 1rem no-repeat,
			linear-gradient(#000, #000) top / 100% calc(100% - 1rem) no-repeat;
	}

	.kicker {
		margin: 0 0 0.5rem;
		font-weight: 600;
		color: var(--gr-text);
	}

	h1 {
		display: flex;
		flex-direction: column;
		margin: 0;
		line-height: 0.88;
		color: #fff;
		scroll-margin-top: 100vh;
	}

	.name {
		font-size: clamp(1.5rem, 3.5vw, 2.25rem);
		line-height: 1;
		margin-bottom: 0.35rem;
	}

	.version {
		font-size: clamp(3rem, 11vw, 8.5rem);
		letter-spacing: -0.02em;
		overflow-wrap: anywhere;
	}

	.version.long {
		font-size: clamp(2.75rem, 6.5vw, 5.5rem);
		line-height: 0.92;
	}

	.stamp {
		margin: 1.25rem 0 0;
		transform: rotate(-3deg);
		transform-origin: left center;
	}

	.side {
		display: grid;
		gap: 0.75rem;
		align-content: end;
		padding: 1rem;
		background: rgb(28 32 40 / 0.78);
	}

	@media (min-width: 60rem) {
		.inner {
			grid-template-columns: minmax(0, 1fr) 17rem;
			align-items: end;
		}
	}
</style>
