---
// The summary at the end of a showcase changelog (rendered by MarkdownContent.astro): how many
// changes the changelog lists in each group, sorted by src/data/changes.ts. It's a slim strip of
// counts under a rule; the lines themselves are in the full changelog above.
import { GROUPS, sortChanges } from '../../data/changes';

interface Props {
	body?: string;
}

const { body } = Astro.props;
const groups = sortChanges(body);
const filled = GROUPS.filter((g) => groups[g.id].length > 0);
const total = filled.reduce((sum, g) => sum + groups[g.id].length, 0);
---

{
	total > 0 && (
		<section class="overview not-content" aria-labelledby="overview">
			<div class="head">
				<h2 id="overview">What changed</h2>
				<p>
					{total} {total === 1 ? 'change' : 'changes'} in total
				</p>
			</div>
			<ul class="groups">
				{filled.map((g) => {
					const n = groups[g.id].length;
					return (
						<li>
							<span class="n">{n}</span> {n === 1 ? g.one : g.many}
						</li>
					);
				})}
			</ul>
		</section>
	)
}

<style>
	.overview {
		display: grid;
		gap: 1.25rem;
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 3px solid var(--gr-text-strong);
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
	}

	h2 {
		margin: 0;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		line-height: 1;
		color: var(--gr-text-strong);
	}

	.head p {
		margin: 0;
		color: var(--gr-muted);
	}

	.groups {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(9.5rem, 100%), 1fr));
		gap: 1rem clamp(1.25rem, 3vw, 2.5rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--gr-line);
		font-family: var(--gr-font-display);
		font-stretch: var(--gr-display-stretch);
		font-weight: 850;
		font-size: var(--sl-text-xl);
		line-height: 1;
		color: var(--gr-text-strong);
	}

	.n {
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		line-height: 0.85;
	}
</style>
