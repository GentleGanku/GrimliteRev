---
// The home page poster: the name set as large as the screen allows over the hero art, what
// Grimlite Rev is, and the newest release's download. It fills the first screen, so the next
// section starts below the fold instead of peeking in. The files come from the release data, so
// the buttons follow each new release without editing the page.
//
// Like the release posters it is an art area: dark in both themes, the art at full strength,
// and the text on a dark patch. The bottom fades into the page.
import HeroMedia from './HeroMedia.astro';
import { downloadUrl, latestRelease } from '../../data/metrics';

interface Props {
	intro?: string;
	stamp?: string;
	media: { video?: string; image?: string; poster?: string; placeholder?: string };
}

const { intro, media } = Astro.props;
const stamp = Astro.props.stamp ?? (latestRelease ? `${latestRelease.label} is out` : undefined);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const x64 = latestRelease?.files.find((f) => f.key === 'x64') ?? latestRelease?.files[0];
const x86 = latestRelease?.files.find((f) => f.key === 'x86');
const mb = (bytes: number) => `${(bytes / 1e6).toFixed(1)} MB`;
const downloads = (n?: number) => (n === undefined ? undefined : `${n.toLocaleString('en-US')} downloads`);
const changelog = latestRelease ? `${base}/changelog/${latestRelease.tag.replace(/\./g, '-')}/` : undefined;
---

<header class="home-poster gr-bleed gr-dark">
	<div class="art">
		<HeroMedia {...media} />
	</div>
	<div class="content">
		<div class="title">
			<h1 id="_top">Grimlite Rev</h1>
			{
				stamp && changelog && (
					<a class="gr-stamp stamp" href={changelog}>
						{stamp}
					</a>
				)
			}
		</div>
		<div class="row">
			{intro && <p class="intro">{intro}</p>}
			{
				latestRelease && x64 && (
					<div class="get">
						<a class="download" href={downloadUrl(latestRelease.tag, x64)} title={x64.name}>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M12 3v12m0 0-5-5m5 5 5-5M5 20h14" />
							</svg>
							<span>
								<span class="action">Download {latestRelease.label}</span>
								<span class="file">
									<span>x64 (64-bit)</span>
									<span>{mb(x64.size)}</span>
									{downloads(x64.downloads) && <span>{downloads(x64.downloads)}</span>}
								</span>
							</span>
						</a>
						{x86 && (
							<p class="alt">
								Try x64 first. If Grimlite Rev shows an error, or the PC is old or slow, use the{' '}
								<a href={downloadUrl(latestRelease.tag, x86)} title={x86.name}>
									x86 (32-bit) build
								</a>{' '}
								({mb(x86.size)}).
							</p>
						)}
					</div>
				)
			}
		</div>
	</div>
</header>

<style>
	.home-poster {
		position: relative;
		display: flex;
		align-items: center;
		min-height: calc(100svh - var(--sl-nav-height));
		margin-top: -1.5rem;
		padding-block: 3rem 7rem;
		color: var(--gr-text);
	}

	/* The art fills the hero and fades out over its last 7rem, into the page below. */
	.art {
		position: absolute;
		inset: 0;
		background: var(--gr-base);
		mask: linear-gradient(to bottom, #000 calc(100% - 7rem), transparent);
	}

	.content {
		position: relative;
		z-index: 2;
		width: 100%;
		pointer-events: none;
	}

	.title,
	.row > * {
		pointer-events: auto;
	}

	.title {
		position: relative;
		display: inline-block;
		max-width: 100%;
		padding: 1rem 1.5rem 1.75rem;
		background: rgb(28 32 40 / 0.78);
		mask: var(--gr-book-edge-bottom) bottom / 100% 1rem no-repeat,
			linear-gradient(#000, #000) top / 100% calc(100% - 1rem) no-repeat;
	}

	h1 {
		margin: 0;
		font-size: clamp(4rem, 16vw, 12.5rem);
		line-height: 0.82;
		letter-spacing: -0.03em;
		color: #fff;
		overflow-wrap: anywhere;
	}

	/* The stamp sits on the title's top edge, like a label stuck onto the poster. */
	.stamp {
		position: absolute;
		top: 0.25rem;
		right: 0.5rem;
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-size: var(--sl-text-base);
		text-decoration: none;
		transform: rotate(-4deg);
	}

	.stamp:hover {
		text-decoration: underline;
	}

	.row {
		display: grid;
		gap: 1.5rem;
		margin-top: 1.5rem;
	}

	.intro,
	.get {
		padding: 1.25rem 1.5rem;
		background: rgb(28 32 40 / 0.78);
	}

	.intro {
		justify-self: start;
		max-width: 34ch;
		margin: 0;
		font-size: clamp(1.2rem, 2.1vw, 1.5rem);
		line-height: 1.4;
		color: var(--gr-text-strong);
	}

	.get {
		justify-self: start;
	}

	.download {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		min-height: 44px;
		padding: 1rem 1.5rem 1rem 1.25rem;
		background: var(--gr-accent);
		color: var(--gr-on-accent);
		text-decoration: none;
	}

	.download:hover .action {
		text-decoration: underline;
	}

	.download svg {
		flex: none;
		width: 1.75rem;
		height: 1.75rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.25;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.download > span {
		display: flex;
		flex-direction: column;
	}

	.action {
		font-family: var(--gr-font-display);
		font-stretch: var(--gr-display-stretch);
		font-weight: 850;
		font-size: var(--sl-text-2xl);
		line-height: 1.1;
	}

	.file {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.75rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}

	.alt {
		max-width: 38ch;
		margin: 1rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--gr-text);
	}

	.alt a {
		color: #fff;
		font-weight: 600;
	}

	@media (min-width: 50rem) {
		.row {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: end;
		}

		.get {
			justify-self: end;
		}
	}

	@media (width < 50rem) {
		.stamp {
			position: static;
			margin-top: 0.75rem;
		}
	}
</style>
