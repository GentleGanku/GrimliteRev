---
// The home page poster: the name set as large as the screen allows over the hero art, what
// Grimlite Rev is, and the newest release's download. It fills the first screen, so the next
// section starts below the fold instead of peeking in. The files come from the release data, so
// the buttons follow each new release without editing the page.
//
// The same layout as the changelog posters: the name set large, then on one line the tagline
// stamp and the newest release's download, with the 32-bit advice under the download, all
// centred in the banner's height. Like the release posters it is an art area: dark in both themes, the
// art dimmed to 38% so the text sits straight on it (white stays above 4.5:1 even over white
// art), and it ends on a straight edge where the next section starts.
import HeroMedia from './HeroMedia.astro';
import { downloadUrl, latestRelease } from '../../data/metrics';
import { downloadData } from '../../data/downloads';

interface Props {
	stamp?: string;
	media: { video?: string; image?: string; poster?: string; placeholder?: string };
	follow?: boolean;
}

const { stamp, media, follow = false } = Astro.props;
const x64 = latestRelease?.files.find((f) => f.key === 'x64') ?? latestRelease?.files[0];
const x86 = latestRelease?.files.find((f) => f.key === 'x86');
const mb = (bytes: number) => `${(bytes / 1e6).toFixed(1)} MB`;
---

<header class="home-poster gr-bleed gr-dark">
	<div class="art" data-follow-art={follow ? '' : undefined}>
		<HeroMedia {...media} />
	</div>
	<div class="inner">
		<h1 id="_top">Grimlite Rev</h1>
		{stamp && <p class="gr-stamp stamp">{stamp}</p>}
		{
			latestRelease && x64 && (
				<a
					class="download"
					href={downloadUrl(latestRelease.tag, x64)}
					title={x64.name}
					{...downloadData(latestRelease, x64)}
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M12 3v12m0 0-5-5m5 5 5-5M5 20h14" />
					</svg>
					<span>
						<span class="action">Download Grimlite Rev</span>
						<span class="file">
							{latestRelease.label} &bull; 64-bit &bull; {mb(x64.size)}
						</span>
					</span>
				</a>
			)
		}
		{
			latestRelease && x86 && (
				<p class="alt">
					If Grimlite Rev shows an error or the PC is old and slow, use the{' '}
					<a href={downloadUrl(latestRelease.tag, x86)} title={x86.name} {...downloadData(latestRelease, x86)}>
						32-bit build
					</a>{' '}
					instead.
				</p>
			)
		}
	</div>
</header>

<script>
	// The hero art follows the reader on wide screens (see FollowRail.astro): it starts as the
	// hero's background, glides into the empty slot beside Presenting as Spotlight comes up, then
	// into the slot on the left of the sections after it. Each slot is sticky, so the art scrolls
	// with the page and is never left behind. The art layer is fixed and placed over the active
	// slot on every scroll frame; between two places its box is interpolated over part of a
	// screen of scrolling. With reduced motion it jumps from one place to the next instead. On
	// narrow screens, and without the slots, it stays in the hero.
	const art = document.querySelector<HTMLElement>('[data-follow-art]');
	const hero = art?.closest<HTMLElement>('.home-poster');
	const spot = document.querySelector<HTMLElement>('[data-follow-slot="spotlight"]');
	const rail = document.querySelector<HTMLElement>('[data-follow-slot="rail"]');
	if (art && hero && spot && rail) {
		const wide = matchMedia('(min-width: 60rem)');
		const still = matchMedia('(prefers-reduced-motion: reduce)');
		const zone = (el: Element) => {
			const top = el.getBoundingClientRect().top;
			const t = Math.min(Math.max((innerHeight * 0.85 - top) / (innerHeight * 0.4), 0), 1);
			if (still.matches) return t < 0.5 ? 0 : 1;
			return t * t * (3 - 2 * t);
		};
		const mix = (a: DOMRect, b: DOMRect, t: number) => ({
			x: a.x + (b.x - a.x) * t,
			y: a.y + (b.y - a.y) * t,
			w: a.width + (b.width - a.width) * t,
			h: a.height + (b.height - a.height) * t,
		});
		const reset = () => {
			art.removeAttribute('style');
			art.classList.remove('in-slot');
		};
		let queued = false;
		const place = () => {
			queued = false;
			if (!wide.matches) return reset();
			const toSpot = zone(spot.closest('section') ?? spot);
			const toRail = zone(rail.closest('[data-follow-rail]') ?? rail);
			const box =
				toRail > 0
					? mix(spot.getBoundingClientRect(), rail.getBoundingClientRect(), toRail)
					: mix(hero.getBoundingClientRect(), spot.getBoundingClientRect(), toSpot);
			const dim = toRail > 0 ? 1 : 0.38 + 0.62 * toSpot;
			Object.assign(art.style, {
				position: 'fixed',
				inset: 'auto',
				left: `${box.x}px`,
				top: `${box.y}px`,
				width: `${box.w}px`,
				height: `${box.h}px`,
				zIndex: '1',
			});
			art.style.setProperty('--dim', String(dim));
			art.classList.toggle('in-slot', toRail > 0 || toSpot > 0.5);
		};
		const queue = () => {
			if (!queued) {
				queued = true;
				requestAnimationFrame(place);
			}
		};
		addEventListener('scroll', queue, { passive: true });
		addEventListener('resize', queue);
		wide.addEventListener('change', queue);
		place();
	}
</script>

<style>
	.home-poster {
		position: relative;
		display: flex;
		background: var(--gr-base);
		align-items: center;
		min-height: calc(100svh - var(--sl-nav-height));
		margin-top: -1.5rem;
		padding-block: 4rem;
		color: #fff;
	}

	/* The art fills the first screen and ends on a straight edge. */
	.art {
		position: absolute;
		inset: 0;
		background: var(--gr-base);
	}

	.art :global(video),
	.art :global(img) {
		opacity: var(--dim, 0.38);
	}

	/* Following the reader (script below): the art is placed over its slot, at full strength,
	   with the placeholder's label in its own corner. */
	.art[data-follow-art].in-slot :global(.placeholder span) {
		right: 1rem;
	}

	.inner {
		position: relative;
		z-index: 2;
		display: grid;
		gap: 1.5rem;
		width: 100%;
		pointer-events: none;
	}

	.inner > * {
		pointer-events: auto;
	}

	h1 {
		margin: 0;
		font-size: clamp(3.5rem, 13vw, 10rem);
		line-height: 0.82;
		letter-spacing: -0.03em;
		color: #fff;
		overflow-wrap: anywhere;
	}

	.stamp {
		justify-self: start;
		margin: 0;
		font-size: var(--sl-text-lg);
		transform: rotate(-3deg);
		transform-origin: left center;
	}

	.download {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		min-height: 44px;
		padding: 0.9rem 1.5rem 0.9rem 1.25rem;
		background: var(--gr-accent);
		color: var(--gr-on-accent);
		text-decoration: none;
	}

	.download:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}

	.download:hover .action {
		text-decoration: underline;
	}

	.download svg {
		flex: none;
		width: 1.75rem;
		height: 1.75rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.25;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.download > span {
		display: flex;
		flex-direction: column;
	}

	.action {
		font-family: var(--gr-font-display);
		font-stretch: var(--gr-display-stretch);
		font-weight: 850;
		font-size: var(--sl-text-2xl);
		line-height: 1.1;
	}

	.file {
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}

	.alt {
		max-width: 34ch;
		margin: 0;
		font-size: var(--sl-text-sm);
		color: #fff;
	}

	.alt a {
		color: #fff;
		font-weight: 700;
	}

	/* Phones: a smaller tagline keeps the stamp on one line. */
	@media (width < 30rem) {
		.stamp {
			font-size: var(--sl-text-sm);
		}
	}

	/* Wide screens: the title on top, then the stamp and the download on one line, then the
	   32-bit advice under the download (the changelog posters' grid). */
	@media (min-width: 60rem) {
		.inner {
			grid-template-columns: minmax(0, 1fr) auto;
			grid-template-areas:
				'title .'
				'stamp download'
				'. alt';
			align-items: center;
			row-gap: 0.5rem;
		}

		h1 {
			grid-area: title;
			margin-bottom: 1rem;
		}

		.stamp {
			grid-area: stamp;
		}

		.download {
			grid-area: download;
			justify-self: end;
		}

		.alt {
			grid-area: alt;
			justify-self: end;
			text-align: end;
		}
	}
</style>
