---
// A release's headline features as numbered stops on a dashed line. The order is a tour of
// the app, from the Main Menu to the Bot Manager, which is why the stops are numbered.
// `compact` drops the images and keeps the line on the left, for the home page spotlight.
import Placeholder from './Placeholder.astro';

interface Stop {
	title: string;
	where: string;
	blurb: string;
	image: string;
}

interface Props {
	stops: Stop[];
	compact?: boolean;
}

const { stops, compact = false } = Astro.props;
---

<ol class:list={['stops', { compact }]}>
	{
		stops.map((stop, i) => (
			<li class:list={['stop', { featured: !compact && i === 0, flip: !compact && i % 2 === 0 }]}>
				<span class="number gr-stamp" aria-hidden="true">
					{i + 1}
				</span>
				{!compact && (
					<div class="media">
						<Placeholder label={stop.image} />
					</div>
				)}
				<div class="text">
					<p class="where">{stop.where}</p>
					<h3>{stop.title}</h3>
					<p class="blurb">{stop.blurb}</p>
				</div>
			</li>
		))
	}
</ol>

<style>
	.stops {
		--spine: 3rem;
		position: relative;
		display: grid;
		gap: 2.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* The dashed line the stops hang on. */
	.stops::before {
		content: '';
		position: absolute;
		inset-block: 1rem;
		inset-inline-start: calc(var(--spine) / 2 - 1px);
		border-inline-start: 2px dashed var(--gr-line);
	}

	.stop {
		position: relative;
		display: grid;
		grid-template-columns: var(--spine) minmax(0, 1fr);
		column-gap: 1rem;
		row-gap: 1rem;
		align-items: start;
	}

	.number {
		grid-column: 1;
		grid-row: 1;
		justify-self: center;
		min-width: 2.25rem;
		padding-inline: 0.5em;
		font-size: var(--sl-text-xl);
		font-stretch: var(--gr-display-stretch);
		text-align: center;
	}

	.media,
	.text {
		grid-column: 2;
	}

	.where {
		margin: 0;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--gr-muted);
	}

	h3 {
		margin: 0.15rem 0 0;
		font-size: var(--sl-text-3xl);
		line-height: 1.05;
		color: var(--gr-text-strong);
	}

	.blurb {
		max-width: 34rem;
		margin: 0.5rem 0 0;
	}

	.compact {
		gap: 1.5rem;
	}

	.compact h3 {
		font-size: var(--sl-text-2xl);
	}

	.compact .blurb {
		font-size: var(--sl-text-sm);
	}

	/* Wide screens: the line runs down the middle and the stops alternate sides of it. The first
	   stop gets the full width for its image, because it opens the tour. */
	@media (min-width: 60rem) {
		.stops:not(.compact) {
			--spine: 4rem;
			gap: 4rem;
		}

		.stops:not(.compact)::before {
			inset-inline-start: calc(50% - 1px);
		}

		.stops:not(.compact) .stop {
			grid-template-columns: minmax(0, 1fr) var(--spine) minmax(0, 1fr);
			column-gap: 2rem;
		}

		.stops:not(.compact) .number {
			grid-column: 2;
		}

		.stops:not(.compact) .media {
			grid-column: 1;
			grid-row: 1;
		}

		.stops:not(.compact) .text {
			grid-column: 3;
			grid-row: 1;
			align-self: center;
		}

		.stops:not(.compact) .flip .media {
			grid-column: 3;
		}

		.stops:not(.compact) .flip .text {
			grid-column: 1;
			text-align: end;
			justify-self: end;
		}

		.stops:not(.compact) .flip .blurb {
			margin-inline-start: auto;
		}

		.stops:not(.compact) .featured .media {
			grid-column: 1 / -1;
			grid-row: 1;
			position: relative;
			z-index: 1;
		}

		.stops:not(.compact) .featured .media :global(.placeholder) {
			aspect-ratio: 21 / 9;
		}

		.stops:not(.compact) .featured .number {
			grid-row: 2;
		}

		.stops:not(.compact) .featured .text {
			grid-column: 3;
			grid-row: 2;
			text-align: start;
			justify-self: start;
		}

		.stops:not(.compact) .featured .blurb {
			margin-inline-start: 0;
		}
	}
</style>
