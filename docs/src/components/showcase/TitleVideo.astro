---
// A muted looping video that fills its parent, with a play/pause button. It starts from the
// script rather than with `autoplay`, so visitors who ask for reduced motion get the poster
// frame and a Play button instead of a moving background.
interface Props {
	src: string;
	poster: string;
}

const withBase = (path: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + path;
const { src, poster } = Astro.props;
---

<div class="title-video" data-title-video>
	<video src={withBase(src)} poster={withBase(poster)} muted loop playsinline preload="metadata" aria-hidden="true"></video>
	<button type="button" aria-label="Play video" data-state="paused" hidden>
		<svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true">
			<path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path>
		</svg>
		<svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true">
			<path d="M8 5v14l11-7z"></path>
		</svg>
	</button>
</div>

<script>
	for (const banner of document.querySelectorAll<HTMLElement>('[data-title-video]')) {
		const video = banner.querySelector('video')!;
		const button = banner.querySelector('button')!;
		const sync = () => {
			button.dataset.state = video.paused ? 'paused' : 'playing';
			button.setAttribute('aria-label', video.paused ? 'Play video' : 'Pause video');
		};
		video.addEventListener('play', sync);
		video.addEventListener('pause', sync);
		button.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
		button.hidden = false;
		if (!matchMedia('(prefers-reduced-motion: reduce)').matches) video.play().catch(sync);
	}
</script>

<style>
	.title-video {
		position: absolute;
		inset: 0;
	}

	video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 35%;
	}

	button {
		position: absolute;
		right: max(var(--sl-content-pad-x), calc((100vw - 67.5rem) / 2));
		bottom: 1rem;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 0.375rem;
		background: rgb(28 32 40 / 0.7);
		color: #fff;
		cursor: pointer;
	}

	button[hidden] {
		display: none;
	}

	button:hover {
		background: rgb(28 32 40 / 0.9);
	}

	button:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}

	button svg {
		width: 20px;
		height: 20px;
		fill: currentColor;
	}

	button[data-state='playing'] .icon-play,
	button[data-state='paused'] .icon-pause {
		display: none;
	}
</style>
