---
// Replaces Starlight's Footer: its own parts first (pagination, where a page has it), then a
// one-line bar on every page, the bottom counterpart of the header: the name, the licence and a
// not-affiliated note, and who made it. The "Make sure…" download popup is rendered here too, so
// every page with a download link has it once.
import Default from '@astrojs/starlight/components/Footer.astro';
import DownloadDialog from './DownloadDialog.astro';
import logo from '../assets/grimlite-rev.png';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<Default />
<div class="site-footer gr-bleed print:hidden">
	<div class="bar">
		<a class="brand" href={siteTitleHref}>
			<img alt="" src={logo.src} width={logo.width} height={logo.height} />
			<span translate="no">Grimlite Rev</span>
		</a>
		<p class="note">Free and open source under CC0. Not affiliated with Artix Entertainment.</p>
		<p class="by">
			Made by @{''}
			<a href="https://github.com/GentleGanku" target="_blank" rel="noopener">
				GentleGanku<span class="sr-only"> (opens in a new tab)</span>
			</a>
		</p>
	</div>
</div>
<DownloadDialog />

<style>
	/* Edge to edge like the header (no .gr-bleed content padding), and the last thing on the
	   page: Starlight's bottom padding under the content is dropped. */
	.site-footer {
		margin-top: 5rem;
		padding-inline: 0;
		border-top: 1px solid var(--gr-line);
		background: var(--gr-base);
	}

	:global(main:has(.site-footer)),
	:global(.content-panel:has(.site-footer)) {
		padding-bottom: 0;
	}

	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 1.5rem;
		min-height: var(--sl-nav-height);
		padding: 0.25rem var(--sl-nav-pad-x);
		font-size: var(--sl-text-sm);
		color: var(--gr-muted);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 44px;
		color: var(--gr-text-strong);
		font-family: var(--gr-font-display);
		font-stretch: var(--gr-display-stretch);
		font-weight: 850;
		font-size: var(--sl-text-lg);
		text-decoration: none;
	}

	.brand img {
		width: auto;
		height: 1.5rem;
	}

	p {
		margin: 0;
	}

	.note {
		flex: 1;
		min-width: min(100%, 18rem);
	}

	.by a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--gr-text-strong);
		font-weight: 600;
	}

	/* On phones the header is two rows tall; the footer keeps one row's height per line. */
	@media (width < 50rem) {
		.bar {
			min-height: 3.5rem;
			padding-block: 0.5rem;
		}
	}
</style>
