---
// Replaces Starlight's SiteTitle. Importing the logo lets Astro write a URL that includes the
// site base (/GrimliteRev), so it loads on GitHub Pages. The logo has a fixed height because
// the header is two rows tall on phones.
import logo from '../assets/grimlite-rev.png';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
	<img alt="" src={logo.src} width={logo.width} height={logo.height} class="logo" />
	<span translate="no">{siteTitle}</span>
</a>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 44px;
		min-width: 0;
		color: var(--gr-text-strong);
		font-family: var(--gr-font-display);
		font-stretch: var(--gr-display-stretch);
		font-weight: 850;
		font-size: 1.5rem;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
	}

	.logo {
		width: auto;
		height: 2.25rem;
	}

	span {
		overflow: hidden;
	}
</style>
