---
// Replaces Starlight's PageTitle. Pages whose frontmatter sets `showcase` get a poster header
// instead of the plain <h1>:
//   home     the home page poster
//   release  a major release: poster (downloads and versions on its right), the overview of
//            changes, then the highlighted features (`presenting`, `stops`, `note`)
//   build    an older build: poster, then the overview of changes on the showcase tint
// The page's Markdown follows as the full changelog (src/components/MarkdownContent.astro).
// Other pages keep Starlight's plain <h1>, with download buttons when they set `release`.
import DownloadButtons from './DownloadButtons.astro';
import HomePoster from './showcase/HomePoster.astro';
import NoteCard from './showcase/NoteCard.astro';
import Presenting from './showcase/Presenting.astro';
import ReleasePoster from './showcase/ReleasePoster.astro';
import Stops from './showcase/Stops.astro';
import { findRelease, latestRelease } from '../data/metrics';

// Starlight's page-title id: the "Overview" link and the skip link target it.
const PAGE_TITLE_ID = '_top';

const { entry } = Astro.locals.starlightRoute;
const { title, titleVideo, heroMedia, release, showcase } = entry.data;

const published = release ? findRelease(release)?.published : undefined;
const date = published
	? new Date(`${published}T00:00:00Z`).toLocaleDateString('en-GB', {
			day: 'numeric',
			month: 'long',
			year: 'numeric',
			timeZone: 'UTC',
		})
	: undefined;
const isLatest = release !== undefined && release === latestRelease?.tag;
// One stamp carries the release date, and says so when this is the newest release: "Latest
// release since 15 October 2026". Older pages show the date (or the build's date range) alone.
const when = showcase?.kicker ?? date;
const stamp = showcase?.stamp ?? (isLatest ? (when ? `Latest release since ${when}` : 'Latest release') : when);
const media = heroMedia ?? (titleVideo ? { video: titleVideo.src, poster: titleVideo.poster } : { placeholder: `${title} art` });
const hasHighlights = showcase?.kind === 'release' && showcase.presenting !== undefined;
---

{
	showcase?.kind === 'home' ? (
		<HomePoster intro={showcase.intro} stamp={showcase.stamp} media={media} />
	) : showcase ? (
		<>
			<ReleasePoster title={title} stamp={stamp} release={release} media={media} />
			{hasHighlights && showcase.presenting && (
				<section class="highlights gr-bleed gr-tinted" aria-labelledby="highlights">
					<Presenting id="highlights" {...showcase.presenting} />
					{showcase.stops && <Stops stops={showcase.stops} />}
					{showcase.note && (
						<div class="note">
							<NoteCard tag={showcase.note.tag} title={showcase.note.title}>
								<p>{showcase.note.body}</p>
							</NoteCard>
						</div>
					)}
				</section>
			)}
		</>
	) : (
		<>
			<h1 id={PAGE_TITLE_ID}>{title}</h1>
			{release && <DownloadButtons tag={release} />}
		</>
	)
}

<style>
	h1 {
		margin-top: 1rem;
		font-size: clamp(2.5rem, 7vw, 4.5rem);
		line-height: 1;
		color: var(--gr-text-strong);
	}

	.highlights {
		display: grid;
		gap: 3rem;
		margin-top: 0;
		padding-block: 3.5rem 4.5rem;
	}

	.note {
		display: flex;
		justify-content: flex-end;
	}
</style>
