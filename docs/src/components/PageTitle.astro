---
// Replaces Starlight's PageTitle. Pages whose frontmatter sets `showcase` get a poster header
// instead of the plain <h1>: the home page poster, or a changelog poster with the release's
// downloads, a version list and, for major releases, the highlighted features. The page's
// Markdown follows as the full changelog. Other pages keep Starlight's plain <h1>, with
// download buttons when they set `release`.
import DownloadButtons from './DownloadButtons.astro';
import HomePoster from './showcase/HomePoster.astro';
import JumpLinks from './showcase/JumpLinks.astro';
import NoteCard from './showcase/NoteCard.astro';
import Presenting from './showcase/Presenting.astro';
import ReleasePicker from './showcase/ReleasePicker.astro';
import ReleasePoster from './showcase/ReleasePoster.astro';
import Stops from './showcase/Stops.astro';
import { findRelease, latestRelease } from '../data/metrics';

// Starlight's page-title id: the "Overview" link and the skip link target it.
const PAGE_TITLE_ID = '_top';

const { entry, headings } = Astro.locals.starlightRoute;
const { title, titleVideo, release, showcase } = entry.data;

const published = release ? findRelease(release)?.published : undefined;
const date = published
	? new Date(`${published}T00:00:00Z`).toLocaleDateString('en-GB', {
			day: 'numeric',
			month: 'long',
			year: 'numeric',
			timeZone: 'UTC',
		})
	: undefined;
const isLatest = release !== undefined && release === latestRelease?.tag;
const stamp = showcase?.stamp ?? (isLatest ? 'Latest release' : undefined);
---

{
	showcase?.kind === 'home' ? (
		<HomePoster intro={showcase.intro} stamp={showcase.stamp} />
	) : showcase ? (
		<>
			<ReleasePoster
				title={title}
				kicker={showcase.kicker ?? date}
				stamp={stamp}
				video={showcase.kind === 'release' ? titleVideo : undefined}
				compact={showcase.kind === 'build'}
			/>
			<div class="under-poster">
				{release && <DownloadButtons tag={release} />}
				<ReleasePicker />
			</div>
			{showcase.kind === 'release' && showcase.presenting && (
				<section class="highlights gr-bleed gr-tinted" aria-labelledby="highlights">
					<Presenting id="highlights" {...showcase.presenting} />
					{showcase.stops && <Stops stops={showcase.stops} />}
					{showcase.note && (
						<div class="note">
							<NoteCard tag={showcase.note.tag} title={showcase.note.title}>
								<p>{showcase.note.body}</p>
							</NoteCard>
						</div>
					)}
				</section>
			)}
			{showcase.kind === 'release' && <JumpLinks headings={headings} />}
		</>
	) : (
		<>
			<h1 id={PAGE_TITLE_ID}>{title}</h1>
			{release && <DownloadButtons tag={release} />}
		</>
	)
}

<style>
	h1 {
		margin-top: 1rem;
		font-size: clamp(2.5rem, 7vw, 4.5rem);
		line-height: 1;
		color: var(--gr-text-strong);
	}

	.under-poster {
		display: grid;
		gap: 1.5rem;
		padding-top: 1.5rem;
	}

	.highlights {
		display: grid;
		gap: 3rem;
		margin-top: 4.5rem;
		padding-block: 3.5rem 4.5rem;
	}

	.note {
		display: flex;
		justify-content: flex-end;
	}
</style>
