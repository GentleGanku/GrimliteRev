---
// Home: the newest major release's highlights in short, taken from that release's changelog
// page (its `showcase` frontmatter), next to the release art, or next to the hero video when it
// follows the reader.
import { getCollection } from 'astro:content';
import Presenting from '../showcase/Presenting.astro';
import Stops from '../showcase/Stops.astro';
import { latestRelease } from '../../data/metrics';
import { heroFollows } from '../../data/follow';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pages = await getCollection('docs');
const page =
	pages.find((p) => p.data.release === latestRelease?.tag && p.data.showcase?.kind === 'release') ??
	pages.find((p) => p.data.showcase?.kind === 'release');
const showcase = page?.data.showcase;
const art = page?.data.titleVideo?.poster;
// When the hero video follows the reader, it takes the art's place: an empty sticky slot that
// HomePoster.astro moves the video into.
const follows = await heroFollows();
---

{
	page && showcase?.presenting && (
		<section class="spotlight gr-bleed gr-tinted not-content" aria-labelledby="spotlight">
			<div class="lead">
				<Presenting id="spotlight" {...showcase.presenting} />
				{showcase.stops && <Stops stops={showcase.stops.slice(0, 4)} compact />}
				<a class="more" href={`${base}/${page.id}/`}>
					See everything in {page.data.sidebar?.label ?? page.data.title}
				</a>
			</div>
			{follows ? (
				<div class="art slot" data-follow-slot="spotlight" aria-hidden="true" />
			) : art && (
				<figure class="art">
					<img src={`${base}${art}`} alt="" loading="lazy" decoding="async" />
				</figure>
			)}
		</section>
	)
}

<style>
	.spotlight {
		display: grid;
		gap: 3rem;
		/* Pulls up over Starlight's padding between the title panel and the content (1.5rem
		   each), so the book edge meets the bottom of the hero with no gap. */
		margin-top: -3rem;
		padding-block: 3.5rem 4rem;
	}

	/* Above the moving hero video, which passes behind this text while it glides in. */
	.lead {
		position: relative;
		z-index: 2;
		display: grid;
		gap: 2.25rem;
		align-content: start;
	}

	.more {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 1.25rem;
		border: 2px solid var(--gr-text-strong);
		color: var(--gr-text-strong);
		font-weight: 700;
		text-decoration: none;
	}

	.more:hover {
		background: var(--gr-text-strong);
		color: var(--gr-tint);
	}

	.art {
		margin: 0;
	}

	img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		/* Centred on the character at the left of the release art. */
		object-position: 10% 40%;
		transform: rotate(1.5deg);
	}

	.slot {
		display: none;
	}

	@media (min-width: 60rem) {
		.slot {
			display: block;
			aspect-ratio: 16 / 9;
		}

		.spotlight {
			grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
			align-items: start;
		}

		.art {
			position: sticky;
			top: calc(var(--sl-nav-height) + 2rem);
		}
	}
</style>
