---
// The Roadmap page (data and lanes in src/data/roadmap.ts). Features flow left to right through
// Proposed, Up next, In progress and Released; Miscellaneous, what keeps it running well, sits
// below in Now and Completed. Every feature can be upvoted. Visitors can add their own
// suggestion to Proposed: it goes live at once through the counter Worker (worker/src/index.js),
// up to 5 open per visitor, and the maintainer can take it down there.
//
// The build's snapshot (public/metrics/votes.json, suggestions.json) renders without
// JavaScript; the script then swaps in the Worker's live votes and suggestions. Visitor text is
// only ever set with textContent.
import { LANES, isSample, roadmap, versionOf, type RoadmapItem } from '../data/roadmap';
import { suggestions, votes, WORKER } from '../data/metrics';
import Glyph from './Glyph.astro';

interface Card {
	id: string;
	title: string;
	description: string;
	version?: string;
	author?: string;
	// A visitor's suggestion from the Worker; the script replaces these with the live list.
	visitor?: boolean;
	votes: number;
}

const byVotes = (a: Card, b: Card) => b.votes - a.votes;
const toCard = (item: RoadmapItem): Card => ({
	id: item.id,
	title: item.title,
	description: item.description,
	version: versionOf(item),
	author: item.author,
	votes: votes[item.id] ?? 0,
});
const cardsFor = (section: string, lane: string) =>
	roadmap.items.filter((i) => i.section === section && i.lane === lane).map(toCard);

const visitorCards: Card[] = suggestions.map((s) => ({
	id: s.id,
	title: s.title,
	description: s.description,
	author: s.author,
	visitor: true,
	votes: votes[s.id] ?? 0,
}));

const lanes = {
	features: LANES.features.map((lane) => ({
		...lane,
		cards: [...cardsFor('features', lane.id), ...(lane.id === 'proposed' ? visitorCards : [])].sort(byVotes),
	})),
	misc: LANES.misc.map((lane) => ({ ...lane, cards: cardsFor('misc', lane.id) })),
};
const count = (n: number) => n.toLocaleString('en-US');
---

<div class="roadmap not-content" data-roadmap data-worker={WORKER}>
	{isSample && <p class="sample-bar">Sample items for preview. Not on the live site.</p>}
	<p class="status" role="status" data-status-line></p>

	<section class="board features gr-bleed gr-tinted" aria-labelledby="rm-features">
		<div class="head">
			<h2 id="rm-features">Features</h2>
			<p>From a proposal to a release, left to right. Vote for the ones you want. If you wish to cancel a vote, you can just click it again!</p>
		</div>
		<div class="lanes">
			{
				lanes.features.map((lane) => (
					<details class="lane" open data-lane={lane.id}>
						<summary>
							<span class:list={['icon', `is-${lane.id}`]}>
								<Glyph name={lane.id} />
							</span>
							<span class="lane-title">
								<h3 id={`lane-${lane.id}`}>{lane.title}</h3>
								<span class="count" data-lane-count>
									{lane.cards.length}
								</span>
							</span>
							<span class="note">{lane.note}</span>
						</summary>
						<div class="body">
							{lane.id === 'proposed' && (
								<button type="button" class="suggest-open" data-suggest-open>
									Suggest a feature
								</button>
							)}
							<ul aria-labelledby={`lane-${lane.id}`} data-cards>
								{lane.cards.map((card) => (
									<li class="card" id={`item-${card.id}`} tabindex="-1" data-suggestion={card.visitor ? '' : undefined}>
										<h4>{card.title}</h4>
										<p class="desc">{card.description}</p>
										{card.author && (
											<p class="by">
												<span aria-hidden="true">– </span>
												<span class="sr-only">Suggested by </span>
												<span data-author>{card.author}</span>
											</p>
										)}
										<div class="foot">
											{card.version && <span class="tag">{card.version}</span>}
											<button type="button" class="vote" aria-pressed="false" data-id={card.id} data-title={card.title}>
												<svg viewBox="0 0 24 24" aria-hidden="true">
													<path d="m6 15 6-6 6 6" />
												</svg>
												<span class="vote-text sr-only">Upvote</span>
												<span class="vote-count">{count(card.votes)}</span>
												<span class="sr-only"> votes</span>
											</button>
										</div>
									</li>
								))}
							</ul>
							<p class="empty" data-empty hidden={lane.cards.length > 0}>
								{lane.empty}
							</p>
						</div>
					</details>
				))
			}
		</div>
	</section>

	<section class="board misc" aria-labelledby="rm-misc">
		<div class="head">
			<h2 id="rm-misc">Miscellaneous</h2>
			<p>These are what keeps Grimlite Rev running well: client patches, optimizations, and adhoc.</p>
		</div>
		<div class="lanes">
			{
				lanes.misc.map((lane) => (
					<details class="lane" open data-lane={lane.id}>
						<summary>
							<span class:list={['icon', `is-${lane.id}`]}>
								<Glyph name={lane.id} />
							</span>
							<span class="lane-title">
								<h3 id={`lane-${lane.id}`}>{lane.title}</h3>
								<span class="count">{lane.cards.length}</span>
							</span>
							<span class="note">{lane.note}</span>
						</summary>
						<div class="body">
							<ul aria-labelledby={`lane-${lane.id}`}>
								{lane.cards.map((card) => (
									<li class="card">
										<h4>{card.title}</h4>
										<p class="desc">{card.description}</p>
										{card.version && (
											<div class="foot">
												<span class="tag">{card.version}</span>
											</div>
										)}
									</li>
								))}
							</ul>
							{lane.cards.length === 0 && <p class="empty">{lane.empty}</p>}
						</div>
					</details>
				))
			}
		</div>
	</section>

	<template data-card-template>
		<li class="card" tabindex="-1" data-suggestion>
			<h4></h4>
			<p class="desc"></p>
			<p class="by">
				<span aria-hidden="true">– </span>
				<span class="sr-only">Suggested by </span>
				<span data-author></span>
			</p>
			<div class="foot">
				<button type="button" class="vote" aria-pressed="false">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="m6 15 6-6 6 6"></path>
					</svg>
					<span class="vote-text sr-only">Upvote</span>
					<span class="vote-count">0</span>
					<span class="sr-only"> votes</span>
				</button>
			</div>
		</li>
	</template>

	<dialog class="suggest" aria-labelledby="suggest-title" data-suggest-dialog>
		<form method="dialog" data-suggest-form novalidate>
			<h2 id="suggest-title">Suggest a feature</h2>
			<p class="lead">
				It goes under Proposed straight away, where everyone can vote for it. Keep it to one feature.
			</p>
			<label>
				<span class="label">Feature name</span>
				<input name="title" required minlength="3" maxlength="60" autocomplete="off" />
				<span class="left" data-left="60"></span>
			</label>
			<label>
				<span class="label">What it would let you do</span>
				<textarea name="description" required minlength="10" maxlength="240" rows="3"></textarea>
				<span class="left" data-left="240"></span>
			</label>
			<label>
				<span class="label">Your name, shown with it</span>
				<input name="author" maxlength="32" autocomplete="nickname" placeholder="A visitor" />
			</label>
			<p class="mine" data-mine></p>
			<p class="error" role="alert" data-error></p>
			<div class="actions">
				<button type="button" class="cancel" data-suggest-cancel>Cancel</button>
				<button type="submit" class="send" value="send">Send suggestion</button>
			</div>
		</form>
	</dialog>
</div>

<script>
	const root = document.querySelector<HTMLElement>('[data-roadmap]')!;
	const worker = root.dataset.worker!;
	const statusLine = root.querySelector<HTMLElement>('[data-status-line]')!;
	const proposed = root.querySelector<HTMLElement>('[data-lane="proposed"]')!;
	const proposedList = proposed.querySelector<HTMLUListElement>('[data-cards]')!;
	const template = root.querySelector<HTMLTemplateElement>('[data-card-template]')!;
	const dialog = root.querySelector<HTMLDialogElement>('[data-suggest-dialog]')!;
	const form = root.querySelector<HTMLFormElement>('[data-suggest-form]')!;
	const errorLine = form.querySelector<HTMLElement>('[data-error]')!;
	const mineLine = form.querySelector<HTMLElement>('[data-mine]')!;
	// Items this visitor has voted for, as the Worker reports them.
	const voted = new Set<string>();
	const counts: Record<string, number> = {};
	let open = { mine: 0, limit: 5 };


	function render(button: HTMLButtonElement) {
		const id = button.dataset.id!;
		const on = voted.has(id);
		button.setAttribute('aria-pressed', String(on));
		button.querySelector('.vote-text')!.textContent = on ? 'Voted' : 'Upvote';
		if (counts[id] !== undefined) button.querySelector('.vote-count')!.textContent = counts[id].toLocaleString('en-US');
	}

	function refreshLane() {
		const n = proposedList.children.length;
		proposed.querySelector('[data-lane-count]')!.textContent = String(n);
		proposed.querySelector<HTMLElement>('[data-empty]')!.hidden = n > 0;
	}

	function card(s: { id: string; title: string; description: string; author: string }) {
		const li = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
		li.id = `item-${s.id}`;
		li.querySelector('h4')!.textContent = s.title;
		li.querySelector('.desc')!.textContent = s.description;
		li.querySelector('[data-author]')!.textContent = s.author;
		const button = li.querySelector<HTMLButtonElement>('.vote')!;
		button.dataset.id = s.id;
		button.dataset.title = s.title;
		render(button);
		return li;
	}

	function showMine() {
		mineLine.textContent = `You have ${open.mine} of ${open.limit} open suggestions.`;
	}

	// Votes: one per visitor and item; a second click takes it back. A plain-text body keeps the
	// request simple, so the browser sends it without a preflight.
	root.addEventListener('click', async (event) => {
		const button = (event.target as Element).closest<HTMLButtonElement>('button.vote');
		if (!button || button.getAttribute('aria-busy') === 'true') return;
		const id = button.dataset.id!;
		const add = !voted.has(id);
		button.setAttribute('aria-busy', 'true');
		try {
			const res = await fetch(`${worker}/${add ? 'vote' : 'unvote'}`, { method: 'POST', body: id });
			if (!res.ok) throw new Error(String(res.status));
			const data: { count: number } = await res.json();
			if (add) voted.add(id);
			else voted.delete(id);
			counts[id] = data.count;
			render(button);
			statusLine.textContent = add
				? `Thanks, your vote for ${button.dataset.title} is in. Click Voted to take it back.`
				: `Your vote for ${button.dataset.title} was taken back.`;
		} catch {
			statusLine.textContent = "Your vote couldn't be sent. Try again in a moment.";
		} finally {
			button.removeAttribute('aria-busy');
		}
	});

	// The suggestion form: counters, plain errors, and the new card at the top of Proposed.
	for (const field of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[maxlength]')) {
		const left = field.parentElement!.querySelector<HTMLElement>('[data-left]');
		if (!left) continue;
		const update = () => (left.textContent = `${field.maxLength - field.value.length} characters left`);
		field.addEventListener('input', update);
		update();
	}
	for (const opener of root.querySelectorAll('[data-suggest-open]')) {
		opener.addEventListener('click', () => {
			errorLine.textContent = '';
			showMine();
			dialog.showModal();
		});
	}
	root.querySelector('[data-suggest-cancel]')!.addEventListener('click', () => dialog.close());
	dialog.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});
	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
		const title = data.title.trim();
		const description = data.description.trim();
		if (title.length < 3) return void (errorLine.textContent = 'Give the feature a name of at least 3 characters.');
		if (description.length < 10) return void (errorLine.textContent = 'Say what it would let you do, in at least 10 characters.');
		if (open.mine >= open.limit) return void (errorLine.textContent = `You already have ${open.limit} open suggestions.`);
		const send = form.querySelector<HTMLButtonElement>('.send')!;
		send.disabled = true;
		errorLine.textContent = '';
		try {
			const res = await fetch(`${worker}/suggest`, {
				method: 'POST',
				body: JSON.stringify({ title, description, author: data.author.trim() }),
			});
			const body = await res.json().catch(() => ({}));
			if (!res.ok) throw new Error(body.error ?? "The suggestion couldn't be sent. Try again in a moment.");
			open = { mine: body.mine, limit: body.limit };
			const li = card(body.suggestion);
			proposedList.prepend(li);
			refreshLane();
			form.reset();
			form.querySelectorAll<HTMLElement>('[maxlength]').forEach((f) => f.dispatchEvent(new Event('input')));
			dialog.close();
			proposed.open = true;
			li.focus();
			statusLine.textContent = `Your suggestion ${body.suggestion.title} is up under Proposed.`;
		} catch (err) {
			errorLine.textContent = err instanceof Error && err.message !== 'Failed to fetch' ? err.message : "The suggestion couldn't be sent. Try again in a moment.";
		} finally {
			send.disabled = false;
		}
	});

	// Phones: the lanes stack, so the later ones start folded. Wide screens show every lane.
	const wide = matchMedia('(min-width: 40rem)');
	const lanes = [...root.querySelectorAll<HTMLDetailsElement>('details.lane')];
	if (!wide.matches) {
		for (const lane of lanes) if (!['proposed', 'up-next', 'now'].includes(lane.dataset.lane!)) lane.open = false;
	}
	for (const lane of lanes) {
		const summary = lane.querySelector('summary')!;
		const sync = () => (wide.matches ? summary.setAttribute('tabindex', '-1') : summary.removeAttribute('tabindex'));
		summary.addEventListener('click', (event) => {
			if (wide.matches) event.preventDefault();
		});
		wide.addEventListener('change', () => {
			if (wide.matches) lane.open = true;
			sync();
		});
		sync();
	}

	// Live data. If the Worker can't be reached, the build's snapshot stays.
	fetch(`${worker}/votes`)
		.then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
		.then((data: { counts: Record<string, number>; mine: string[] }) => {
			for (const id of data.mine) voted.add(id);
			Object.assign(counts, data.counts);
			for (const button of root.querySelectorAll<HTMLButtonElement>('button.vote')) {
				counts[button.dataset.id!] ??= 0;
				render(button);
			}
		})
		.catch(() => {});
	fetch(`${worker}/suggestions`)
		.then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
		.then((data: { suggestions: { id: string; title: string; description: string; author: string }[]; mine: number; limit: number }) => {
			open = { mine: data.mine, limit: data.limit };
			for (const old of proposedList.querySelectorAll('[data-suggestion]')) old.remove();
			for (const s of data.suggestions) proposedList.append(card(s));
			refreshLane();
		})
		.catch(() => {});
</script>

<style>
	.roadmap {
		margin-top: 2rem;
	}

	.sample-bar {
		margin: 0 0 1.5rem;
		padding: 0.75rem 1rem;
		border: 2px dashed var(--gr-accent);
		color: var(--gr-text-strong);
		font-weight: 700;
	}

	.status {
		margin: 0 0 1rem;
		font-size: var(--sl-text-sm);
		color: var(--gr-text);
	}

	.status:empty {
		display: none;
	}

	.board {
		display: grid;
		gap: 2rem;
	}

	.features {
		padding-block: 3rem 4rem;
	}

	.misc {
		margin-top: 4rem;
	}

	.head {
		display: grid;
		gap: 0.5rem;
	}

	.head h2 {
		margin: 0;
		font-size: clamp(2.25rem, 6vw, 3.75rem);
		line-height: 1;
		color: var(--gr-text-strong);
	}

	.head p {
		margin: 0;
		color: var(--gr-text);
	}

	.lanes {
		display: grid;
		gap: 1.5rem;
		align-items: start;
	}

	.lane {
		min-width: 0;
	}

	.body {
		display: grid;
		gap: 0.75rem;
		padding-top: 0.75rem;
	}

	/* Each lane's header: an icon for its stage, its name and count, and one line on what it
	   means. */
	summary {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		column-gap: 0.75rem;
		align-items: center;
		min-height: 44px;
		padding-bottom: 0.75rem;
		border-bottom: 3px solid var(--gr-text-strong);
		list-style: none;
		cursor: pointer;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	/* Phones: lanes fold, so each header shows a chevron that turns when it's open. */
	summary::after {
		content: '';
		grid-column: 3;
		grid-row: 1 / span 2;
		width: 0.6rem;
		height: 0.6rem;
		border-right: 2px solid var(--gr-text-strong);
		border-bottom: 2px solid var(--gr-text-strong);
		transform: rotate(45deg);
	}

	.lane[open] > summary::after {
		transform: rotate(-135deg);
	}

	/* The stage icon, in the site's red, centred on the header's two lines. The tick on done
	   lanes is cut out in the section's own background. */
	.icon {
		grid-row: 1 / span 2;
		align-self: center;
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		color: var(--gr-accent);
	}

	.icon :global(svg) {
		width: 1.6rem;
		height: 1.6rem;
	}

	.features .icon :global(.cut) {
		stroke: var(--gr-tint);
	}

	.misc .icon :global(.cut) {
		stroke: var(--gr-base);
	}

	.lane-title,
	.note {
		grid-column: 2;
		min-width: 0;
	}

	.lane-title {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	h3 {
		margin: 0;
		font-size: var(--sl-text-2xl);
		line-height: 1.05;
		color: var(--gr-text-strong);
	}

	.count {
		font-weight: 600;
		color: var(--gr-muted);
		font-variant-numeric: tabular-nums;
	}

	/* One line, always. */
	.note {
		overflow: hidden;
		font-size: var(--sl-text-sm);
		line-height: 1.3;
		color: var(--gr-text);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	ul {
		display: grid;
		align-content: start;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	ul:empty {
		display: none;
	}

	/* Each item is a plain card on the page colour: the name, what it does and who suggested it,
	   then one row with the version on the left and the vote on the right. */
	.card {
		display: grid;
		gap: 0.5rem;
		padding: 1rem;
		border: 1px solid var(--gr-line);
		background: var(--gr-base);
	}

	.card:focus-visible {
		outline: 2px solid var(--gr-accent);
		outline-offset: 2px;
	}

	/* The vote keeps a 44px target; the row tucks into the card's bottom padding so it doesn't
	   look tall. */
	.foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin: 0 -0.35rem -0.5rem 0;
	}

	h4 {
		margin: 0;
		font-size: var(--sl-text-lg);
		line-height: 1.25;
		color: var(--gr-text-strong);
		overflow-wrap: anywhere;
	}

	.card p {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.by {
		color: var(--gr-muted);
	}

	.tag {
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--gr-text-strong);
	}

	/* The vote, "^ 12": muted at rest; on hover it brightens on a light Surface ground; voted, it
	   turns the site's red. */
	.vote {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		min-width: 44px;
		min-height: 44px;
		margin-left: auto;
		padding: 0 0.6rem;
		border: 0;
		background: transparent;
		color: var(--gr-muted);
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		cursor: pointer;
	}

	.vote:hover {
		background: var(--gr-surface);
		color: var(--gr-text-strong);
	}

	.vote svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.vote-count {
		font-variant-numeric: tabular-nums;
	}

	.vote[aria-pressed='true'] {
		color: var(--gr-accent);
	}

	.vote[aria-busy='true'] {
		opacity: 0.6;
		cursor: progress;
	}

	.suggest-open {
		min-height: 44px;
		padding: 0 1rem;
		border: 2px solid var(--gr-text-strong);
		background: transparent;
		color: var(--gr-text-strong);
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}

	.suggest-open:hover {
		background: var(--gr-text-strong);
		color: var(--gr-base);
	}

	.empty {
		margin: 0;
		padding: 1rem;
		border: 1px dashed var(--gr-line);
		font-size: var(--sl-text-sm);
		color: var(--gr-text);
	}

	/* The suggestion form, in the page's theme. */
	.suggest {
		width: min(32rem, calc(100vw - 2rem));
		max-height: calc(100vh - 2rem);
		margin: auto;
		padding: 0;
		overflow: auto;
