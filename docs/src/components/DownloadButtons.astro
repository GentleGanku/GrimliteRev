---
// Download buttons for one release's files: what the file is ("x64 (64-bit)"), its size and how
// many times it was downloaded. The file name isn't shown, because people pick by build, not by
// name; it stays in the link's tooltip. The files and counts are GitHub's, read at build time;
// the links go through the counter Worker, which notes the visitor's country
// (see src/data/metrics.ts). `stack` is the narrow column on the right of a showcase poster.
import { downloadUrl, findRelease } from '../data/metrics';

interface Props {
	tag: string;
	layout?: 'row' | 'stack';
}

const LABELS: Record<string, string> = {
	x64: 'x64 (64-bit)',
	x86: 'x86 (32-bit)',
	plugins: 'Plugins',
	main: 'Grimlite Rev',
	amogus: 'Amogus',
	ipplugins: 'IP Plugins',
};

const { tag, layout = 'row' } = Astro.props;
const release = findRelease(tag);
const files = release?.files ?? [];
const size = (bytes: number) =>
	bytes >= 1e6 ? `${(bytes / 1e6).toFixed(1)} MB` : `${Math.round(bytes / 1e3)} KB`;
const count = (n: number) => `${n.toLocaleString('en-US')} download${n === 1 ? '' : 's'}`;
---

{
	release && files.length > 0 && (
		<ul class:list={['downloads', 'not-content', layout]} aria-label={`Download ${release.label}`}>
			{files.map((file, i) => (
				<li>
					<a class:list={['download', { primary: i === 0 }]} href={downloadUrl(release.tag, file)} title={file.name}>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M12 3v12m0 0-5-5m5 5 5-5M5 20h14" />
						</svg>
						<span class="text">
							<span class="label">{LABELS[file.key] ?? file.name}</span>
							<span class="meta">
								<span>{size(file.size)}</span>
								{file.downloads !== undefined && <span>{count(file.downloads)}</span>}
							</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.downloads {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.downloads li {
		flex: 1 1 13rem;
		min-width: 0;
	}

	.stack {
		flex-direction: column;
		gap: 0.5rem;
	}

	.stack li {
		flex: none;
	}

	.download {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 44px;
		height: 100%;
		padding: 0.6rem 0.9rem;
		border: 1px solid var(--gr-line);
		border-radius: 0.375rem;
		background: var(--gr-base);
		color: var(--gr-text-strong);
		text-decoration: none;
	}

	.download:hover {
		border-color: var(--gr-text);
	}

	.download:hover .label {
		text-decoration: underline;
	}

	/* The first file (x64, or the release's only build) is the one most people want, so it gets
	   the accent, as the home page's download does. */
	.download.primary {
		border-color: var(--gr-accent);
		background: var(--gr-accent);
		color: var(--gr-on-accent);
	}

	svg {
		flex: none;
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.label {
		font-weight: 700;
		line-height: 1.3;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.75rem;
		font-size: var(--sl-text-xs);
		line-height: 1.4;
		color: var(--gr-text);
	}

	.primary .meta {
		color: var(--gr-on-accent);
	}
</style>
