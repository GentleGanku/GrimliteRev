---
// Replaces Starlight's Header. Destinations are written out as text links instead of an icon
// row, so a first-time visitor can read where each one goes. On phones the links move to a
// second row under the logo and search, because Starlight's mobile menu only exists on pages
// with a sidebar, and Home and the showcase pages have none. The colour theme is an icon
// button beside the title (ThemeToggle.astro). Links that leave the site (GitHub, Discord, Ko-fi)
// open in a new tab, and say so to screen readers.
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeToggle from './ThemeToggle.astro';
import { changelogLinks } from '../data/changelogs';

const { sidebar } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;

const latestChangelog = changelogLinks(sidebar as never)[0]?.href ?? `${base}/changelog/v1-4-0/`;

const links = [
	{ label: 'Changelogs', href: latestChangelog, current: path.startsWith(`${base}/changelog/`) },
	{ label: 'Roadmap', href: `${base}/roadmap/`, current: path.startsWith(`${base}/roadmap/`) },
	{ label: 'Metrics', href: `${base}/metrics/`, current: path.startsWith(`${base}/metrics/`) },
	{ label: 'GitHub', href: 'https://github.com/GentleGanku/GrimliteRev', current: false, external: true },
	{ label: 'Discord', href: 'https://discord.gg/NZ6vmDTu44', current: false, external: true },
];
---

<div class="header">
	<div class="title-wrapper">
		<SiteTitle />
		<ThemeToggle />
	</div>
	<div class="search print:hidden">
		<Search />
	</div>
	<nav class="links print:hidden" aria-label="Site">
		<ul>
			{
				links.map(({ label, href, current, external }) => (
					<li>
						<a
							href={href}
							aria-current={current ? 'page' : undefined}
							target={external ? '_blank' : undefined}
							rel={external ? 'noopener' : undefined}
						>
							{label}
							{external && <span class="sr-only"> (opens in a new tab)</span>}
						</a>
					</li>
				))
			}
			<li>
				<a class="support" href="https://ko-fi.com/gentleganku" target="_blank" rel="noopener">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M11.351 2.715c-2.7 0-4.986.025-6.83.26C2.078 3.285 0 5.154 0 8.61c0 3.506.182 6.13 1.585 8.493 1.584 2.701 4.233 4.182 7.662 4.182h.83c4.209 0 6.494-2.234 7.637-4a9.5 9.5 0 0 0 1.091-2.338C21.792 14.688 24 12.22 24 9.208v-.415c0-3.247-2.13-5.507-5.792-5.870-1.558-.156-2.650-.208-6.857-.208m0 1.947c4.208 0 5.090.052 6.571.182 2.624.311 4.130 1.584 4.130 4v.39c0 2.156-1.792 3.844-3.870 3.844h-.935l-.156.649c-.208 1.013-.597 1.818-1.039 2.546-.909 1.428-2.545 3.064-5.922 3.064h-.805c-2.571 0-4.831-.883-6.078-3.195-1.090-2-1.298-4.155-1.298-7.506 0-2.181.857-3.402 3.012-3.714 1.533-.233 3.559-.26 6.390-.26m6.547 2.287c-.416 0-.650.234-.650.546v2.935c0 .311.234.545.650.545 1.324 0 2.051-.754 2.051-2s-.727-2.026-2.052-2.026m-10.390.182c-1.818 0-3.013 1.480-3.013 3.142 0 1.533.858 2.857 1.949 3.897.727.701 1.870 1.429 2.649 1.896a1.470 1.470 0 0 0 1.507 0c.780-.467 1.922-1.195 2.623-1.896 1.117-1.039 1.974-2.364 1.974-3.897 0-1.662-1.247-3.142-3.039-3.142-1.065 0-1.792.545-2.338 1.298-.493-.753-1.246-1.298-2.312-1.298" />
					</svg>
					<span class="support-text">Support on Ko-fi</span>
					<span class="sr-only"> (opens in a new tab)</span>
				</a>
			</li>
		</ul>
	</nav>
</div>

<style>
	.header {
		display: grid;
		grid-template-columns: auto 1fr auto;
		grid-template-areas: 'title search links';
		align-items: center;
		gap: 1.5rem;
		height: 100%;
	}

	.title-wrapper {
		grid-area: title;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		overflow: clip;
		min-width: 0;
		padding: 0.25rem;
		margin: -0.25rem;
	}

	.search {
		grid-area: search;
		display: flex;
		justify-content: center;
	}

	.links {
		grid-area: links;
		min-width: 0;
	}

	ul {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 44px;
		padding: 0 0.6rem;
		color: var(--gr-text);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}

	a:hover {
		color: var(--gr-text-strong);
		text-decoration: underline;
		text-underline-offset: 0.3em;
	}

	/* The page you're on is underlined in the accent, the one place the header uses it. */
	a[aria-current='page'] {
		color: var(--gr-text-strong);
		text-decoration: underline 2px var(--gr-accent);
		text-underline-offset: 0.45em;
	}

	/* Support is the header's one call to action, so it carries the accent as a filled button. */
	.support {
		margin-inline-start: 0.5rem;
		border-radius: 0.375rem;
		background: var(--gr-accent);
		color: var(--gr-on-accent);
	}

	/* The site's focus ring is the accent, which would vanish on this button, so hover and focus
	   both ring it in the strong text colour. */
	.support:hover,
	.support:focus-visible {
		color: var(--gr-on-accent);
		text-decoration: none;
		outline: 2px solid var(--gr-text-strong);
		outline-offset: 2px;
	}

	.support svg {
		width: 1rem;
		height: 1rem;
		fill: currentColor;
	}

	/* Phones: logo and search on the first row, the links on a second row that scrolls sideways
	   when it doesn't fit. The header grows to hold both rows. */
	@media (width < 50rem) {
		:global(:root) {
			--sl-nav-height: 6.75rem;
		}

		.header {
			grid-template-columns: 1fr auto;
			grid-template-rows: 3rem 3rem;
			grid-template-areas:
				'title search'
				'links links';
			gap: 0 0.75rem;
		}

		.links {
			overflow-x: auto;
			scrollbar-width: none;
			margin-inline: calc(-1 * var(--sl-nav-pad-x));
			padding-inline: calc(var(--sl-nav-pad-x) - 0.6rem);
		}

		.links::-webkit-scrollbar {
			display: none;
		}

		:global([data-has-sidebar]) .links {
			margin-inline-end: calc(-1 * (var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)));
		}
	}

	@media (min-width: 50rem) and (max-width: 72rem) {
		.support {
			gap: 0;
			padding: 0 0.6rem;
		}

		.support-text {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		.support svg {
			width: 1.125rem;
			height: 1.125rem;
		}
	}
</style>
